---
import einstellungen from "../../public/site.json";
import VerwaltungKopf from "../components/VerwaltungKopf.jsx";

/**
 * Rahmen der Verwaltung: eigener Kopf mit Reitern und Veröffentlichen, ohne
 * Kopf, Fuß und Suche der Website. Immer hell, damit sie sich von der Website
 * abhebt; die Werkzeugleiste gibt es hier nicht, der Kopf übernimmt sie.
 */
export interface Props {
  titel: string;
  /** Pfad des Bereichs, dessen Reiter markiert ist. */
  aktiv?: string;
}
const { titel, aktiv } = Astro.props;
---

<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{titel} · Verwaltung · {einstellungen.titel}</title>
  </head>
  <body class="bg-white text-black min-h-screen">
    <VerwaltungKopf client:only="react" kuenstlerName={einstellungen.titel} aktiv={aktiv} />
    <main class="max-w-5xl mx-auto px-4 py-6">
      <h1 class="text-2xl mb-4">{titel}</h1>
      <slot />
    </main>
  </body>
</html>
