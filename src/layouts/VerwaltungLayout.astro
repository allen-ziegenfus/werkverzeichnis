---
import einstellungen from "../../public/site.json";
import VerwaltungApp from "../components/VerwaltungApp.jsx";

/**
 * Rahmen der Verwaltung: eigener Kopf mit Reitern und Veröffentlichen, ohne
 * Kopf, Fuß und Suche der Website. Immer hell, damit sie sich von der Website
 * abhebt; die Werkzeugleiste gibt es hier nicht, der Kopf übernimmt sie.
 * Jede Adresse lädt dieselbe App (VerwaltungApp.jsx, #90); sie wählt den
 * Bereich selbst und wechselt ihn ohne Neuladen.
 */
export interface Props {
  /** Titel bis die App geladen ist. */
  titel: string;
}
const { titel } = Astro.props;
---

<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{titel} · Verwaltung · {einstellungen.titel}</title>
  </head>
  <body class="bg-white text-black min-h-screen">
    <VerwaltungApp client:only="react" kuenstlerName={einstellungen.titel} />
  </body>
</html>
